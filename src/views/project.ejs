<%- include('partials/header') %>
    <main>
        <h1>
            <%= project.title %>
        </h1>
 
        <p><strong>Description:</strong>
            <%= project.description %>
        </p>
        <p><strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString('en-US', { month: 'long' , day: 'numeric' , year: 'numeric' }) %>
        </p>
        <p><strong>Location:</strong>
            <%= project.location %>
        </p>
        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <% if (categories && categories.length > 0) { %>
            <div class="category-tags">
                <strong>Categories:</strong>
                <% categories.forEach(category => { %>
                    <a href="/category/<%= category.category_id %>" class="tag"><%= category.name %></a>
                <% }) %>
            </div>
        <% } %>

        <div class="action-buttons">
            <% if (user && user.role_name==='admin' ) { %>
            <a href="/project/<%= project.project_id %>/edit" class="btn">Edit Project</a>
            <a href="/project/<%= project.project_id %>/assign-categories" class="btn">Edit Categories</a>
            <% } %>

            <% if (isLoggedIn) { %>
                <% if (userIsVolunteering) { %>
                    <p>You are volunteering for this project.</p>
                    <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                        <button type="submit" class="btn">Remove yourself as a volunteer</button>
                    </form>
                    <% } else { %>
                        <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                            <button type="submit" class="btn">Volunteer for this project</button>
                        </form>
                    <% } %>
            <% } %>
        </div>
    </main>
 
    <%- include('partials/footer') %>
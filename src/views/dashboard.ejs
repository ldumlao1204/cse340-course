<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>
        <p>Name: <%= name %>
        </p>
        <p>Username: <%= email %>
        </p>

        <% if (user && user.role_name==='admin' ) { %>
            <p><a href="/users" class="btn">View All Users</a></p>
        <% } %>

        <h2>My Volunteer Projects</h2>
        <% if (volunteeredProjects.length> 0) { %>
            <ul class="item-list">
                <% volunteeredProjects.forEach(project=> { %>
                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                        <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                            <button type="submit" class="btn">Remove</button>
                        </form>
                    </li>
                <% }); %>
            </ul>
            <% } else { %>
                <p>You haven't signed up to volunteer for any projects yet.</p>
            <% } %>
    </main>

<%- include('partials/footer') %>